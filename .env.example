# Local development sample values only. Do not use these credentials in production.
COMPOSE_PROJECT_NAME=canvas-local-mvp

POSTGRES_DB=canvas
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas-local-password

MINIO_ROOT_USER=canvas-minio
MINIO_ROOT_PASSWORD=canvas-minio-local-password
CANVAS_S3_REGION=us-east-1
CANVAS_ORIGINALS_BUCKET=canvas-originals

CANVAS_ADMIN_USERNAME=admin
# BCrypt hash for the local-only password "password". Generate a replacement as documented in README.md.
CANVAS_ADMIN_PASSWORD_HASH='$2a$10$1oiTviKoCVqHe56NZnyhbOutjj8OENLmmDKZIiS8NWN3g5NuOgnL2'
# Plaintext is consumed only by Playwright and never by the application containers.
CANVAS_E2E_ADMIN_USERNAME=admin
CANVAS_E2E_ADMIN_PASSWORD=password
CANVAS_PUBLIC_BASE_URL=http://localhost:5173
CANVAS_UPLOAD_MAX_SIZE=10MB
CANVAS_MAX_SWALLOW_SIZE=16MB
CANVAS_CAPTION_WORKER_URL=http://caption-worker:8000
