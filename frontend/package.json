{
  "name": "canvas-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:task5-integration": "node integration/task5-public-page-through-vite.mjs",
    "test:watch": "vitest --watch",
    "e2e": "playwright test manual-description-publication.spec.ts generated-description-publication.spec.ts accessibility.spec.ts keyboard-accessibility.spec.ts",
    "e2e:persistence": "playwright test persistence-check.spec.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jest-axe": "^10.0.0",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
